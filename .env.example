# =============================================================================
# TalentFlow AI — Environment variables (reference only)
# =============================================================================
# Copy values into:
#   - Local: backend shell / IDE, frontend/talentflow-web/.env
#   - Render: Web Service → Environment (backend)
#   - Netlify: Site settings → Environment variables (frontend)
# See docs/ENVIRONMENT.md for full documentation.
# =============================================================================

# --- Backend (Render or local) ---
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
GEMINI_API_KEY=
APP_AI_MODE=gemini
AI_PROVIDER=gemini
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://talentflow-interview-ai.netlify.app
FILE_UPLOAD_DIR=./uploads

# --- Frontend (Netlify or local) ---
# Vite exposes only variables prefixed with VITE_
VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND_URL.onrender.com/api/v1

# --- Local development overrides (optional) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/talentflow
# SPRING_DATASOURCE_USERNAME=talentflow
# SPRING_DATASOURCE_PASSWORD=talentflow_secret
# VITE_API_BASE_URL=http://localhost:8080/api/v1
